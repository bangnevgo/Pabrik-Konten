DATABASE_URL=file:./db/custom.db

# ─── AI Provider Configuration ───────────────────────────────────
# Supported providers: openrouter | openai | nvidia | opencode | zai
AI_PROVIDER=openrouter

# Your API key for the selected provider
AI_API_KEY=your-api-key-here

# Model to use (uncomment to override the default)
#  OpenRouter: google/gemini-2.0-flash-001, anthropic/claude-sonnet-4, etc.
#  OpenAI:      gpt-4o-mini, gpt-4o, etc.
#  NVIDIA:      meta/llama-3.1-70b-instruct, etc.
#  zai:         default
# AI_MODEL=google/gemini-2.0-flash-001

# Custom base URL if needed (overrides the provider default)
# AI_BASE_URL=https://your-custom-endpoint.com/v1
